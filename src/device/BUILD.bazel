load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# GPU 메모리 관리 라이브러리
cc_library(
    name = "gpu_memory",
    hdrs = ["gpu_memory.h"],
    deps = [
        "@rules_cuda//cuda:runtime",
    ],
)

# GPU 메모리 관리 테스트
cc_test(
    name = "gpu_memory_test",
    srcs = ["gpu_memory_test.cc"],
    deps = [
        ":gpu_memory",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
